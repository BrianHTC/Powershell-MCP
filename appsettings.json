{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "McpServer": {
    "HttpTransportMode": "Stateless",
    "RunspacePool": {
      "MinPoolSize": 2,
      "MaxPoolSize": 16,
      "EagerWarmCount": 2,
      "AcquisitionTimeout": "00:00:15",
      "IdleTtl": "00:05:00",
      "SweepInterval": "00:00:30",
      "StopTimeout": "00:00:05",
      "ShutdownDrainTimeout": "00:00:30",
      "ReplenishCheckInterval": "00:00:05"
    }
  },
  "Authentication": {
    "Enabled": true,
    "DefaultScheme": "ApiKey",
    "DefaultPolicy": {
      "RequireAuthentication": true,
      "RequiredScopes": [],
      "RequiredRoles": [
        "developer"
      ]
    },
    "Schemes": {
      "ApiKey": {
        "Type": "ApiKey",
        "HeaderName": "X-API-Key",
        "Keys": {
          "REPLACE_WITH_YOUR_API_KEY": {
            "Scopes": [],
            "Roles": [
              "developer"
            ]
          }
        }
      }
    }
  },
  "PowerShellConfiguration": {
    "ExcludePatterns": [],
    "IncludePatterns": [],
    "EnableDynamicReloadTools": false,
    "EnableConfigurationTroubleshootingTool": false,
    "Performance": {
      "EnableResultCaching": false,
      "UseDefaultDisplayProperties": true
    },
    "SubprocessHostMode": "Pool",
    "SubprocessRunspacePoolSize": 0,
    "CommandOverrides": {
      "Invoke-PowerShell": {
        "EnableResultCaching": false,
        "AllowAnonymous": false,
        "RequiredScopes": [],
        "RequiredRoles": [
          "developer"
        ]
      }
    },
    "Environment": {
      "ImportModules": [
        "InvokePowerShell"
      ]
    },
    "CommandNames": [
      "Invoke-PowerShell"
    ],
    "Modules": [
      "InvokePowerShell"
    ]
  }
}